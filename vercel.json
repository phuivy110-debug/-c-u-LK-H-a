{
  "buildCommand": "tsx scripts/generate-seo-files.ts && vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/seo/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/seo/robots.txt"
    },
    {
      "source": "/feed.xml",
      "destination": "/seo/rss.xml"
    },
    {
      "source": "/rss.xml",
      "destination": "/seo/rss.xml"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
