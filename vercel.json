{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/danh-muc/tat-ca",
      "destination": "/san-pham",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.docaulkhoa.vn"
        }
      ],
      "destination": "https://docaulkhoa.vn/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/seo/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/seo/robots.txt"
    },
    {
      "source": "/feed.xml",
      "destination": "/seo/rss.xml"
    },
    {
      "source": "/rss.xml",
      "destination": "/seo/rss.xml"
    }
  ]
}
