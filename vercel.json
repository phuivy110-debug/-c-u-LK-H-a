{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "includeFiles": "api/_published_sheet_fallback.csv"
    },
    "api/sitemap.ts": {
      "includeFiles": "api/_published_sheet_fallback.csv"
    },
    "api/rss.ts": {
      "includeFiles": "api/_published_sheet_fallback.csv"
    }
  },
  "redirects": [
    {
      "source": "/danh-muc/tat-ca",
      "destination": "/san-pham",
      "permanent": true
    },
    {
      "source": "/cam-nang/can-ca-ty-hon",
      "destination": "/cam-nang/top-can-lure-lk-hoa-cho-nguoi-moi",
      "permanent": true
    },
    {
      "source": "/cam-nang/can-lure-star",
      "destination": "/cam-nang/top-can-lure-lk-hoa-cho-nguoi-moi",
      "permanent": true
    },
    {
      "source": "/cam-nang/can-lure-two",
      "destination": "/cam-nang/top-can-lure-lk-hoa-cho-nguoi-moi",
      "permanent": true
    },
    {
      "source": "/cam-nang/can-lure-hoc-sinh",
      "destination": "/cam-nang/top-can-lure-lk-hoa-cho-nguoi-moi",
      "permanent": true
    },
    {
      "source": "/cam-nang/can-lure-sv-pro",
      "destination": "/cam-nang/top-can-lure-lk-hoa-cho-nguoi-moi",
      "permanent": true
    },
    {
      "source": "/cam-nang/can-ul-suoi",
      "destination": "/cam-nang/top-can-lure-lk-hoa-cho-nguoi-moi",
      "permanent": true
    },
    {
      "source": "/cam-nang/moi-lure-bo",
      "destination": "/cam-nang/top-moi-lure-ca-loc-lk-hoa",
      "permanent": true
    },
    {
      "source": "/cam-nang/moi-ca-sat",
      "destination": "/cam-nang/top-moi-lure-ca-loc-lk-hoa",
      "permanent": true
    },
    {
      "source": "/cam-nang/moi-cau-rua",
      "destination": "/cam-nang/top-moi-lure-ca-loc-lk-hoa",
      "permanent": true
    },
    {
      "source": "/cam-nang/moi-lure-10g-to",
      "destination": "/cam-nang/top-moi-lure-ca-loc-lk-hoa",
      "permanent": true
    },
    {
      "source": "/cam-nang/moi-snake-mini",
      "destination": "/cam-nang/top-moi-lure-ca-loc-lk-hoa",
      "permanent": true
    },
    {
      "source": "/cam-nang/moi-nhai-hoi",
      "destination": "/cam-nang/top-moi-lure-ca-loc-lk-hoa",
      "permanent": true
    },
    {
      "source": "/cam-nang/nhai-hoi-bkk",
      "destination": "/cam-nang/top-moi-lure-ca-loc-lk-hoa",
      "permanent": true
    },
    {
      "source": "/cam-nang/can-dai-ro-chep-2026",
      "destination": "/cam-nang/so-sanh-can-lk-tong-hop-va-lk-ro-chep",
      "permanent": true
    },
    {
      "source": "/cam-nang/can-dai-ro-chep-pro-4h",
      "destination": "/cam-nang/so-sanh-can-lk-tong-hop-va-lk-ro-chep",
      "permanent": true
    },
    {
      "source": "/cam-nang/phao-cau-luc",
      "destination": "/cam-nang/cach-chon-phao-cau-dai-lk-hoa",
      "permanent": true
    },
    {
      "source": "/cam-nang/du-lk-red-x8",
      "destination": "/cam-nang/du-lk-x8",
      "permanent": true
    },
    {
      "source": "/cam-nang/luoi-cau-don",
      "destination": "/cam-nang/luoi-san-hang",
      "permanent": true
    },
    {
      "source": "/cam-nang/luoi-cau-dai",
      "destination": "/cam-nang/luoi-san-hang",
      "permanent": true
    },
    {
      "source": "/cam-nang/khoa-link-snap",
      "destination": "/danh-muc/phu-kien",
      "permanent": true
    },
    {
      "source": "/cam-nang/kep-gap-ca",
      "destination": "/danh-muc/phu-kien",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.docaulkhoa.vn"
        }
      ],
      "destination": "https://docaulkhoa.vn/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/orders",
      "destination": "/api/index"
    },
    {
      "source": "/api/orders/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/connectors",
      "destination": "/api/index"
    },
    {
      "source": "/api/connectors/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/pos/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/shipping/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/analytics/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/shopee-prices",
      "destination": "/api/index"
    },
    {
      "source": "/api/shopee-prices/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/products",
      "destination": "/api/index"
    },
    {
      "source": "/api/sync-sheet",
      "destination": "/api/index"
    },
    {
      "source": "/api/extract-shopee-image",
      "destination": "/api/index"
    },
    {
      "source": "/api/agent/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/seo/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/seo/robots.txt"
    },
    {
      "source": "/feed.xml",
      "destination": "/seo/rss.xml"
    },
    {
      "source": "/rss.xml",
      "destination": "/seo/rss.xml"
    },
    {
      "source": "/gio-hang",
      "destination": "/index.html"
    },
    {
      "source": "/thanh-toan",
      "destination": "/index.html"
    },
    {
      "source": "/quan-ly-don-hang",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/.well-known/agent.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
